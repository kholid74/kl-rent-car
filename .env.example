# Neon: DATABASE_URL wajib host "-pooler" (runtime serverless),
# sslmode=verify-full dipatok eksplisit agar perilaku SSL tidak berubah di pg v9.
# DIRECT_URL wajib host tanpa "-pooler" (prisma migrate tidak jalan lewat pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

NEXT_PUBLIC_SITE_URL="https://kl-rent-car.demo.kalsara.id"
# Nomor tujuan semua tombol WhatsApp. Format 62xxx, tanpa + dan tanpa spasi.
NEXT_PUBLIC_WA_NUMBER="6281200000000"
# "true" memasang noindex dan menampilkan banner demo.
NEXT_PUBLIC_DEMO_MODE="true"

# Dipakai prisma/seed.ts untuk membuat satu akun admin.
ADMIN_EMAIL="admin@klrentcar.demo"
ADMIN_PASSWORD="ganti-password-ini"

# Header x-demo-reset-token pada POST /api/demo/reset harus cocok dengan nilai ini.
DEMO_RESET_TOKEN="ganti-token-ini"
